.claude/settings.local.json
# Nested worktree checkouts -- these carry their own .git *file* (not a
# nested repo dir), so `git add -A` here would otherwise walk into them and
# try to stage everything inside, .venv/.build caches included.
.claude/worktrees/
.superpowers/
.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.swp
ios/TinyTalkCore/.build/
ios/TinyTalkCore/.swiftpm/
ios/TinyTalkApp/TinyTalkApp.xcodeproj/xcuserdata/
ios/TinyTalkApp/TinyTalkApp.xcodeproj/project.xcworkspace/xcuserdata/
server/data/
ios/TinyTalkApp/Local.xcconfig
.DS_Store
