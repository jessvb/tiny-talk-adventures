# Copy to android/local.secrets.properties (gitignored; NEVER commit it -- this repo is public)
# and fill in. Every key is optional; a missing/empty one builds fine and the app
# asks for it in Settings instead.
#
# WARNING: these values are baked into the APK (BuildConfig) and can be extracted from it.
# Use dedicated, revocable keys with usage limits for any build you hand to testers.

# Groq (chat + Whisper STT): console.groq.com
GROQ_API_KEY=
# Cloudflare Workers AI (illustrations): your account id
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with Workers AI permission only
CLOUDFLARE_API_TOKEN=
# API Ninjas (animal facts): api-ninjas.com
API_NINJAS_KEY=
