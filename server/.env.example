# Copy this file to .env (in this same server/ directory) and fill in real
# values. .env is loaded automatically on server startup -- see
# tinytalk/config.py -- so there's no need to `export` these by hand.
# .env itself is gitignored; this .example file is the only one committed.
#
# Everything below is optional. With nothing set, the server runs fully
# local against Ollama and just skips animal-fact lookups -- see README.md's
# Setup section for details on each one.

# --- LLM backend ---
# "ollama" (default, local/private) or "groq" (hosted, for A/B latency
# testing -- see tinytalk/llm_groq.py's module docstring).
TINYTALK_LLM_BACKEND=ollama

# Required only when TINYTALK_LLM_BACKEND=groq. Free key:
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Animal facts (optional) ---
# Real animal facts get woven into the story when the child mentions a known
# animal. Free key (100 requests/hour): https://api-ninjas.com
ANIMAL_FACTS_API_KEY=
